ggplot2::labs(title = paste("Boxplot of Model", metric, "by Trait"),
x = "Model",
y = metric)
plotly_boxplot_reps <- plotly::ggplotly(ggplot_boxplot_reps)
list(metric = metric,
ggplot_boxplot_reps = ggplot_boxplot_reps,
plotly_boxplot_reps = plotly_boxplot_reps)
})
