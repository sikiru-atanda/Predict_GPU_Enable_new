library(keras)
vae_model <- function(input_dim,
latent_dim = 16,
hidden_units = c(128, 64),
dropout_rate = 0.3,
l2_reg = 1e-5,
use_batchnorm = TRUE,
is_categorical = FALSE) {
encoder <- NULL
decoder <- NULL
encoder_model <- function() {
keras_model_custom(name = "Encoder", function(self) {
self$dense_layers <- list()
for (units in hidden_units) {
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_dense(
units = units,
activation = NULL,
kernel_regularizer = regularizer_l2(l2_reg)
)
if (use_batchnorm)
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_batch_normalization()
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_activation("relu")
if (dropout_rate > 0)
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_dropout(rate = dropout_rate)
}
self$z_mean <- layer_dense(units = latent_dim)
self$z_log_var <- layer_dense(units = latent_dim)
self$call <- function(inputs, training = FALSE) {
x <- inputs
for (layer in self$dense_layers)
x <- layer(x, training = training)
z_mean <- self$z_mean(x)
z_log_var <- self$z_log_var(x)
epsilon <- k_random_normal(shape = k_shape(z_mean))
z <- z_mean + k_exp(0.5 * z_log_var) * epsilon
self$add_loss(-0.5 * k_mean(1 + z_log_var - k_square(z_mean) - k_exp(z_log_var)))
z
}
})
}
decoder_model <- function() {
keras_model_custom(name = "Decoder", function(self) {
self$dense_layers <- list()
rev_units <- rev(hidden_units)
for (units in rev_units) {
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_dense(
units = units,
activation = NULL,
kernel_regularizer = regularizer_l2(l2_reg)
)
if (use_batchnorm)
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_batch_normalization()
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_activation("relu")
if (dropout_rate > 0)
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_dropout(rate = dropout_rate)
}
self$output_layer <- layer_dense(
units = input_dim,
activation = ifelse(is_categorical, "softmax", "linear")
)
self$call <- function(inputs, training = FALSE) {
x <- inputs
for (layer in self$dense_layers)
x <- layer(x, training = training)
self$output_layer(x)
}
})
}
vae <- keras_model_custom(name = "VAE", function(self) {
self$encoder <- encoder_model()()
self$decoder <- decoder_model()()
self$call <- function(inputs, training = FALSE) {
z <- self$encoder(inputs, training = training)
reconstructed <- self$decoder(z, training = training)
# Add reconstruction loss
if (is_categorical) {
recon_loss <- loss_categorical_crossentropy(inputs, reconstructed)
} else {
recon_loss <- loss_mean_squared_error(inputs, reconstructed)
}
self$add_loss(k_mean(recon_loss))
reconstructed
}
})
return(vae)
}
