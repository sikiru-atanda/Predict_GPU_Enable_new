reticulate::use_condaenv("r-bayes", required = TRUE)
# 2) Purge any half-imported modules from the Python runtime
reticulate::py_run_string("
import sys
for m in ['jax', 'jaxlib', 'jax.numpy', 'jax._src', 'ml_dtypes']:
if m in sys.modules:
del sys.modules[m]
")
