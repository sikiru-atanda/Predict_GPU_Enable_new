reticulate::py_run_string("
import sys, importlib.util, os, pprint
print('Active Python:', sys.executable)
print('sys.path (search order):')
pprint.pp(sys.path, width=120)
spec = importlib.util.find_spec('jax')
print('\\nfind_spec(\"jax\") =>', spec)
if spec:
print('origin :', getattr(spec, 'origin', None))
print('loader :', type(spec.loader))
")
