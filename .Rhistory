library(PredictProR)
m1_cv <- model_execute(
pheno_data = phenotypic_train_test,
geno_data = genomic_data,
#gmatrix_method = "Yang",
gen_name = "Hybrid",
random = ~ "Hybrid",
cross_validation = TRUE,
replication = 3,
response = "Yield_Mg_ha",
GS_model_cv = c("BRR"),
cross_validation_meth = "Hold_Out",
eval_metrics = c("accuracy",
"mean_squared_error",
"bias",
"root_mean_squared_error",
"relative_squared_error",
"mean_absolute_error",
"mean_absolute_percent_error",
"kendalls_tau"),
qc_filtering = FALSE,
system_database = TRUE,
nIter = 200,
thin = 5,
engine = "asreml"
)
length(which(is.na(phenotypic_train_test$Yield_Mg_ha)))
length(m1_cv$Yield_Mg_ha$model_results$bayes_result$Predicted_value$Hybrid)
dim(genomic_data)
length(setdiff(rownames(genomic_data), phenotypic_train_test$Hybrid))
