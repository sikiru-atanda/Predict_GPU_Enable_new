l2_lambda = c(0, 1e-4),
use_batchnorm = c(FALSE, TRUE),
input_type = c("categorical")
)
results <- list()
#geno_data <- scale()
geno_omic_object <- geno_data[-tst, ]
geno_omic_test_object <- geno_data[tst, ]
for (i in seq_len(nrow(param_grid))) {
params <- param_grid[i, ]
message("Running model ", i, " of ", nrow(param_grid))
res <- vae_model_geno_custom(
train_data = geno_omic_object,
test_data = geno_omic_test_object,
encoding_dim = params$encoding_dim,
intermediate_dim = params$intermediate_dim,
dropout_rate = params$dropout_rate,
l2_lambda = params$l2_lambda,
use_batchnorm = params$use_batchnorm,
input_type = params$input_type,
epochs = 50
)
results[[i]] <- list(params = params, error = res$test_reconstruction_error)
}
library(reticulate)
vae_model <- function(input_dim,
latent_dim = 10,
hidden_units = c(128, 64),
dropout_rate = 0.2,
l2_reg = 1e-4,
use_batchnorm = TRUE,
is_categorical = FALSE) {
# Encoder network
encoder <- keras_model_custom(name = "encoder", function(self) {
self$dense_layers <- list()
for (units in hidden_units) {
layer <- layer_dense(units, activation = "relu",
kernel_regularizer = regularizer_l2(l2_reg))
self$dense_layers[[length(self$dense_layers) + 1]] <- layer
if (use_batchnorm) {
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_batch_normalization()
}
if (dropout_rate > 0) {
self$dense_layers[[length(self$dense_layers) + 1]] <- layer_dropout(rate = dropout_rate)
}
self$z_mean <- layer_dense(latent_dim, name = "z_mean")
self$z_log_var <- layer_dense(latent_dim, name = "z_log_var")
self$call <- function(inputs, training = TRUE) {
x <- inputs
for (layer in self$dense_layers) x <- layer(x, training = training)
z_mean <- self$z_mean(x)
z_log_var <- self$z_log_var(x)
epsilon <- k_random_normal(shape = k_shape(z_mean))
z <- z_mean + k_exp(0.5 * z_log_var) * epsilon
list(z = z, z_mean = z_mean, z_log_var = z_log_var)
}
})
# Decoder network
decoder <- keras_model_custom(name = "decoder", function(self) {
self$decoder_layers <- list()
for (units in rev(hidden_units)) {
layer <- layer_dense(units, activation = "relu",
kernel_regularizer = regularizer_l2(l2_reg))
self$decoder_layers[[length(self$decoder_layers) + 1]] <- layer
if (use_batchnorm) {
self$decoder_layers[[length(self$decoder_layers) + 1]] <- layer_batch_normalization()
}
if (dropout_rate > 0) {
self$decoder_layers[[length(self$decoder_layers) + 1]] <- layer_dropout(rate = dropout_rate)
}
self$output_layer <- layer_dense(input_dim,
activation = if (is_categorical) "softmax" else "sigmoid")
self$call <- function(z, training = TRUE) {
x <- z
for (layer in self$decoder_layers) x <- layer(x, training = training)
self$output_layer(x)
}
})
# VAE (combining encoder + decoder)
vae <- keras_model_custom(name = "VAE", function(self) {
self$encoder <- encoder()
self$decoder <- decoder()
self$call <- function(inputs, training = TRUE) {
enc_out <- self$encoder(inputs, training = training)
z <- enc_out$z
z_mean <- enc_out$z_mean
z_log_var <- enc_out$z_log_var
reconstructed <- self$decoder(z, training = training)
# Reconstruction loss
recon_loss <- if (is_categorical) {
loss_categorical_crossentropy(inputs, reconstructed)
} else {
loss_mean_squared_error(inputs, reconstructed)
}
recon_loss <- k_mean(recon_loss)
# KL divergence
kl_loss <- -0.5 * k_mean(1 + z_log_var - k_square(z_mean) - k_exp(z_log_var))
# Total loss
self$add_loss(recon_loss + kl_loss)
reconstructed
}
})
vae()
}
