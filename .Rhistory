tryCatch({
ypred_cv[tst, "yhat"] <- predict_with_model(model = model, y = yNA, omics_data = omics_data,
tst = tst, additional_params = additional_params)
}, error = function(e) {
message(paste("Error in processing AI model", model, "for", trait, ": ", e$message))
handle_error <<- TRUE
})
}
