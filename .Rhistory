# Example reliability categorization function
reliability_thresholds_CI <- function(boot_results, thresholds = c(0.33, 0.66)) {
lower_bound <- apply(boot_results$t, 2, quantile, probs = 0.05)
upper_bound <- apply(boot_results$t, 2, quantile, probs = 0.95)
interval_width <- upper_bound - lower_bound
threshold1 <- quantile(interval_width, thresholds[1])
threshold2 <- quantile(interval_width, thresholds[2])
rel_remarks <- ifelse(interval_width < threshold1, "high",
ifelse(interval_width < threshold2, "moderate", "low"))
return(list(lower_bound = lower_bound,
upper_bound = upper_bound,
Uncertainty = interval_width,
rel_remarks = rel_remarks))
}
sik = reliability_thresholds_CI(boot_results = boot_results)
testData <- data.frame(predictions = df$predicted,
lower_bound = sik$lower_bound,
upper_bound = sik$upper_bound,
reliability = sik$rel_remarks)
