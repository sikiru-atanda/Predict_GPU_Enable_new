pheno = droplevels(pheno.data[pheno.data$Env%in%c("F5I"), ])
set.seed(123)
tst <- sample(nrow(pheno), 81)
tst_GID <- as.character(pheno$GID[tst])
pheno2[pheno2$GID%in%tst_GID, c("Yield", "deBLUP", "BLUE")] <- NA
length(which(is.na(pheno2$BLUE)))
table(pheno2$Env)
response = c("Yield","BLUE", "deBLUP")
library(dplyr)
pheno2 <- pheno2 %>%
group_by(across(all_of(gen_name))) %>%
mutate(across(all_of(response), ~ifelse(get(gen_name) %in% tst_GID, NA, .)))
