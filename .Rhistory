# 1. Run PCA on the training genotype matrix
pca_result <- prcomp(geno_omic_object, center = TRUE, scale. = TRUE)
# 2. Compute variance explained by each PC
explained_var <- pca_result$sdev^2 / sum(pca_result$sdev^2)
cum_var <- cumsum(explained_var)
# 3. Select number of PCs explaining 90% of variance
n_pc <- which(cum_var >= 0.90)[1]
n_pc
# 4. Get scores for the training data (reduced PC space)
geno_train_pcs <- pca_result$x[, 1:n_pc]
# 5. Project test data onto the same PCA space
geno_test_pcs <- predict(pca_result, newdata = geno_omic_test_object)[, 1:n_pc]
dim(geno_test_pcs)
# Set consistent PC column names
pc_names <- paste0("PC", 1:n_pc)
colnames(geno_train_pcs) <- pc_names
colnames(geno_test_pcs) <- pc_names
model <- lm(pheno_data1[-train, pheno_data1$YIELD] ~ ., data = as.data.frame(geno_train_pcs))
