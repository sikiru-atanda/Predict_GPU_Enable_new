# remove any current jax/jaxlib + cached wheels
system2(py, c("-m","pip","uninstall","-y","jax","jaxlib"))
system2(py, c("-m","pip","cache","purge"))
# install a stable Windows CPU pair (works well): 0.6.2
system2(py, c("-m","pip","install","--no-cache-dir","jax==0.6.2","jaxlib==0.6.2"),
stdout = TRUE, stderr = TRUE)
