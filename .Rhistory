subprocess.run([sys.executable,'-m','pip','cache','purge'])
# Reinstall a *matching* pair; 0.6.2 is stable on Windows CPU
subprocess.check_call([sys.executable,'-m','pip','install','--no-cache-dir','jax==0.6.2','jaxlib==0.6.2'])
")
