#include <iostream>
#include <Eigen/Dense>
#include <Eigen/LU>

extern "C" {
    void mme_marker(
        int n,
        int m,
        const double *y,
        const double *x,
        const double *marker,
        double ve,
        double va,
        double *b,
        double *a,
        double *pev,
        double *sep,
        double *rel
    );
}

Eigen::MatrixXd eye(int n) {
    Eigen::MatrixXd result = Eigen::MatrixXd::Zero(n, n);
    for (int i = 0; i < n; ++i) {
        result(i, i) = 1.0;
    }
    return result;
}

void mme_marker(
    int n,
    int m,
    const double *y,
    const double *x,
    const double *marker,
    double ve,
    double va,
    double *b,
    double *a,
    double *pev,
    double *sep,
    double *rel
) {
    Eigen::Map<const Eigen::VectorXd> y_arr(y, n);
    Eigen::Map<const Eigen::MatrixXd> x_arr(x, n, m);
    Eigen::Map<const Eigen::MatrixXd> marker_arr(marker, n, m);

    Eigen::MatrixXd cxx = x_arr.transpose() * x_arr / ve;
    Eigen::MatrixXd cxm = x_arr.transpose() * marker_arr / ve;
    Eigen::MatrixXd cmm = marker_arr.transpose() * marker_arr / ve +
                          marker_arr.transpose() * marker_arr * va / ve;

    Eigen::MatrixXd xy = x_arr.transpose() * y_arr / ve;
    Eigen::MatrixXd my = marker_arr.transpose() * y_arr / ve;

    Eigen::MatrixXd lhs_upper(m + m, m);
    lhs_upper << cxx, cxm;

    Eigen::MatrixXd lhs_lower(m + m, m);
    lhs_lower << cxm.transpose(), cmm;

    Eigen::MatrixXd lhs(m + m, m + m);
    lhs << lhs_upper, lhs_lower;

    Eigen::MatrixXd rhs(m + m, 1);
    rhs << xy, my;

    Eigen::MatrixXd c = lhs;
    Eigen::VectorXd sol = lhs.lu().solve(rhs);

    Eigen::VectorXd aii = marker_arr.transpose() * marker_arr.diagonal();
    Eigen::VectorXd cii
